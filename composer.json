{
	"name": "yamabikolab/yamabiko-table-reorder",
	"description": "Accessible table row reordering for supported blocks in the WordPress block editor.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require-dev": {
		"phpstan/phpstan": "^2.2",
		"squizlabs/php_codesniffer": "^3.13.6",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.4"
	},
	"scripts": {
		"lint:php": "phpcs --standard=phpcs.xml.dist",
		"format:php": "phpcbf --standard=phpcs.xml.dist",
		"analyse:php": "phpstan analyse",
		"audit:security": "composer audit --abandoned=ignore --ignore-severity=low --ignore-severity=medium"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	}
}
