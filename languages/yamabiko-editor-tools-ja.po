#: src/editor-extensions/table-reorder/with-table-reorder.tsx
msgid "Finish reordering"
msgstr "並べ替えを終了"

#: src/editor-extensions/table-reorder/with-table-reorder.tsx
msgid "Reorder rows"
msgstr "行を並べ替え"

#: src/editor-extensions/table-reorder/with-table-reorder.tsx
msgid "Rows can be reordered by dragging or with the keyboard. For keyboard operation, use Tab or Shift+Tab to select a row, Enter or Space to start reordering, the Up and Down arrow keys to move it, and Enter or Space to confirm. Press Escape to cancel."
msgstr "行はドラッグまたはキーボードで並べ替えできます。キーボード操作では Tab または Shift+Tab で行を選択し、Enter または Space で並べ替えを開始し、上下矢印キーで移動し、Enter または Space で確定します。Esc でキャンセルできます。"

#: src/editor-extensions/table-reorder/with-table-reorder.tsx
msgid "Close instructions"
msgstr "操作ガイドを閉じる"

#: src/editor-extensions/table-reorder/with-table-reorder.tsx
msgid "Rows can be reordered by dragging or with the keyboard"
msgstr "行はドラッグまたはキーボードで並べ替えできます"

#: src/editor-extensions/table-reorder/with-table-reorder.tsx
msgid "Drag:"
msgstr "ドラッグ操作："

#: src/editor-extensions/table-reorder/with-table-reorder.tsx
msgid "Drag the handle on the left to move the row"
msgstr "左のハンドルをドラッグして移動"

#: src/editor-extensions/table-reorder/with-table-reorder.tsx
msgid "Keyboard:"
msgstr "キーボード操作："

#: src/editor-extensions/table-reorder/with-table-reorder.tsx
msgid "Tab / Shift+Tab to select a row → Enter / Space to start → ↑↓ to move → Enter / Space to confirm (Esc to cancel)"
msgstr "Tab / Shift+Tabで行を選択 → Enter / Spaceで開始 → ↑↓で移動 → Enter / Spaceで確定（Escでキャンセル）"

#. translators: %d: table body row number.
#: src/editor-extensions/table-reorder/sortable-row.tsx
#, javascript-format
msgid "Reordering row %d"
msgstr "%d 行目を並べ替え中"

#. translators: %d: table body row number.
#: src/editor-extensions/table-reorder/sortable-row.tsx
#, javascript-format
msgid "Reorder row %d"
msgstr "%d 行目を並べ替える"

#: src/editor-extensions/table-reorder/table-reorder-controller.tsx
msgid "Rows cannot be moved to a position that splits merged cells. Unmerge the cells before reordering."
msgstr "結合セルを分断する位置には行を移動できません。結合を解除してから並べ替えてください。"

#. translators: 1: table body row number, 2: total table body rows.
#: src/editor-extensions/table-reorder/table-reorder-controller.tsx
#, javascript-format
msgid "Started reordering row %1$d of %2$d."
msgstr "%1$d 行目の並べ替えを開始しました。全%2$d行です。"

#. translators: %d: table body row number.
#: src/editor-extensions/table-reorder/table-reorder-controller.tsx
#, javascript-format
msgid "Reordering canceled. Row remains at position %d."
msgstr "並べ替えをキャンセルしました。%d 行目のままです。"

#. translators: 1: original table body row number, 2: destination table body row number.
#: src/editor-extensions/table-reorder/table-reorder-controller.tsx
#, javascript-format
msgid "Moved row %1$d to position %2$d."
msgstr "%1$d 行目を%2$d 行目へ移動しました。"

#: src/editor-extensions/table-reorder/table-reorder-controller.tsx
msgid "Cannot move the row any further up."
msgstr "これ以上上へ移動できません。"

#: src/editor-extensions/table-reorder/table-reorder-controller.tsx
msgid "Cannot move the row any further down."
msgstr "これ以上下へ移動できません。"

#. translators: 1: destination table body row number, 2: total table body rows.
#: src/editor-extensions/table-reorder/table-reorder-controller.tsx
#, javascript-format
msgid "Moving to position %1$d of %2$d."
msgstr "%1$d 行目へ移動します。全%2$d行です。"
