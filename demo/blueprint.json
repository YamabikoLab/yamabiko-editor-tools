{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Yamabiko Table Reorder v0.3.2 Demo",
		"description": "Yamabiko Editor Tools v0.3.2 の Table Reorder を、WordPress Core Table と Flexible Table Block の両方で体験するデモ。",
		"author": "YamabikoLab",
		"categories": [ "demo", "table", "accessibility" ]
	},
	"preferredVersions": {
		"php": "8.3",
		"wp": "7.0"
	},
	"features": {
		"networking": true
	},
	"login": true,
	"landingPage": "/wp-admin/post.php?post=100&action=edit",
	"steps": [
		{
			"step": "setSiteLanguage",
			"language": "ja"
		},
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "Yamabiko Table Reorder Demo",
				"blogdescription": "Yamabiko Editor Tools v0.3.2 の Table Reorder 体験デモ"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/YamabikoLab/yamabiko-editor-tools/releases/download/v0.3.2/yamabiko-editor-tools.zip"
			},
			"options": {
				"activate": true
			},
			"progress": {
				"caption": "Yamabiko Editor Tools v0.3.2 をインストール中..."
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://downloads.wordpress.org/plugin/flexible-table-block.3.9.0.zip"
			},
			"options": {
				"activate": true
			},
			"progress": {
				"caption": "Flexible Table Block v3.9.0 をインストール中..."
			}
		},
		{
			"step": "writeFile",
			"path": "/tmp/create-demo.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/YamabikoLab/yamabiko-editor-tools/main/demo/create-demo.php"
			}
		},
		{
			"step": "runPHPWithOptions",
			"options": {
				"scriptPath": "/tmp/create-demo.php"
			}
		}
	]
}
