{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Yamabiko Table Reorder v0.1.0 Demo",
    "description": "Yamabiko Editor Tools v0.1.0 の Table Reorder を、日本の山30座のCore Tableで体験するデモ。",
