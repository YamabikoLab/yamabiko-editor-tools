			"code": "<?php\nrequire_once '/wordpress/wp-load.php';\n\n$page_id = 100;\n\nif ( get_post( $page_id ) ) {\n\twp_delete_post( $page_id, true );\n}\n\n$rows = [\n\t[1, '富士山', '3,776 m', '山梨県・静岡県'],\n\t[2, '北岳', '3,193 m', '山梨県'],\n\t[3, '奥穂高岳', '3,190 m', '長野県・岐阜県'],\n\t[4, '間ノ岳', '3,190 m', '山梨県・静岡県'],\n\t[5, '槍ヶ岳', '3,180 m', '長野県・岐阜県'],\n\t[6, '赤石岳', '3,121 m', '長野県・静岡県'],\n\t[7, '涸沢岳', '3,110 m', '長野県・岐阜県'],\n\t[8, '北穂高岳', '3,106 m', '長野県・岐阜県'],\n\t[9, '大喰岳', '3,101 m', '長野県・岐阜県'],\n\t[10, '前穂高岳', '3,090 m', '長野県'],\n\t[11, '中岳', '3,084 m', '長野県・岐阜県'],\n\t[12, '荒川中岳', '3,084 m', '静岡県'],\n\t[13, '御嶽山', '3,067 m', '長野県・岐阜県'],\n\t[14, '塩見岳', '3,052 m', '長野県・静岡県'],\n\t[15, '南岳', '3,033 m', '長野県・岐阜県'],\n\t[16, '仙丈ヶ岳', '3,033 m', '山梨県・長野県'],\n\t[17, '乗鞍岳', '3,026 m', '長野県・岐阜県'],\n\t[18, '農鳥岳', '3,026 m', '山梨県・静岡県'],\n\t[19, '立山（大汝山）', '3,015 m', '富山県'],\n\t[20, '聖岳', '3,013 m', '長野県・静岡県'],\n\t[21, '剱岳', '2,999 m', '富山県'],\n\t[22, '水晶岳', '2,986 m', '富山県'],\n\t[23, '甲斐駒ヶ岳', '2,967 m', '山梨県・長野県'],\n\t[24, '木曽駒ヶ岳', '2,956 m', '長野県'],\n\t[25, '白馬岳', '2,932 m', '長野県・富山県'],\n\t[26, '薬師岳', '2,926 m', '富山県'],\n\t[27, '鷲羽岳', '2,924 m', '長野県・富山県'],\n\t[28, '大天井岳', '2,922 m', '長野県'],\n\t[29, '西穂高岳', '2,909 m', '長野県・岐阜県'],\n\t[30, '鹿島槍ヶ岳', '2,889 m', '長野県・富山県']\n];\n\n$table_rows = '';\n\nforeach ( $rows as $row ) {\n\t[ $number, $mountain, $height, $location ] = $row;\n\n\t// 縦結合: 7〜8行目の所在地を2行結合。\n\tif ( 7 === $number ) {\n\t\t$table_rows .= '<tr><td>7</td><td>涸沢岳</td><td>3,110 m</td><td rowspan=\"2\">長野県・岐阜県</td><td>縦結合（所在地）</td></tr>';\n\t\tcontinue;\n\t}\n\n\tif ( 8 === $number ) {\n\t\t$table_rows .= '<tr><td>8</td><td>北穂高岳</td><td>3,106 m</td><td>縦結合（所在地）</td></tr>';\n\t\tcontinue;\n\t}\n\n\t// 横結合: 14行目の「山名」と「標高」を2列結合。\n\tif ( 14 === $number ) {\n\t\t$table_rows .= '<tr><td>14</td><td colspan=\"2\"><strong>塩見岳</strong> / 3,052 m</td><td>長野県・静岡県</td><td>横結合（山名＋標高）</td></tr>';\n\t\tcontinue;\n\t}\n\n\t$table_rows .= sprintf(\n\t\t'<tr><td>%d</td><td>%s</td><td>%s</td><td>%s</td><td></td></tr>',\n\t\t$number,\n\t\tesc_html( $mountain ),\n\t\tesc_html( $height ),\n\t\tesc_html( $location )\n\t);\n}\n\n$core_table =\n\t'<!-- wp:table {\"align\":\"wide\"} -->' .\n\t'<figure class=\"wp-block-table alignwide\"><table class=\"has-fixed-layout\">' .\n\t'<thead><tr><th scope=\"col\">No.</th><th scope=\"col\">山名</th><th scope=\"col\">標高</th><th scope=\"col\">主な所在地</th><th scope=\"col\">備考</th></tr></thead>' .\n\t'<tbody>' . $table_rows . '</tbody>' .\n\t'</table><figcaption class=\"wp-element-caption\">日本の山 30座 / WordPress Core Table デモ</figcaption></figure>' .\n\t'<!-- /wp:table -->';\n\n$flexible_table = <<<'HTML'\n<!-- wp:flexible-table-block/table {\"align\":\"wide\"} --><figure class=\"wp-block-flexible-table-block-table alignwide\"><table class=\"has-fixed-layout\"><thead><tr><th scope=\"col\" style=\"width:64px\">No.</th><th scope=\"col\">山名</th><th scope=\"col\">標高</th><th scope=\"col\">主な所在地</th><th scope=\"col\">備考</th></tr></thead><tbody><tr><th scope=\"row\">1</th><td><strong>Mount Everest</strong></td><td>8,848.86 m</td><td>ネパール・中国</td><td></td></tr><tr><th scope=\"row\">2</th><td><em>K2</em></td><td>8,611 m</td><td>パキスタン・中国</td><td></td></tr><tr><th scope=\"row\">3</th><td><a href=\"https://en.wikipedia.org/wiki/Kangchenjunga\">Kangchenjunga</a></td><td>8,586 m</td><td>ネパール・インド</td><td></td></tr><tr><th scope=\"row\">4</th><td><code>Lhotse</code></td><td>8,516 m</td><td>ネパール・中国</td><td></td></tr><tr><th scope=\"row\">5</th><td><s>Makalu</s></td><td>8,485 m</td><td>ネパール・中国</td><td></td></tr><tr><th scope=\"row\">6</th><td>Cho Oyu<br>チョ・オユー</td><td>8,188 m</td><td>ネパール・中国</td><td></td></tr><tr><th scope=\"row\">7</th><td>Dhaulagiri I</td><td>8,167 m</td><td rowspan=\"2\">ネパール</td><td>縦結合（所在地、7〜8行目）</td></tr><tr><th scope=\"row\">8</th><td>Manaslu</td><td>8,163 m</td><td>縦結合（所在地、7〜8行目）</td></tr><tr><th scope=\"row\">9</th><td class=\"demo-mountain-cell\">Nanga Parbat</td><td>8,126 m</td><td>パキスタン</td><td></td></tr><tr><th scope=\"row\">10</th><td style=\"font-weight:600;background-color:#f0f6fc\">Annapurna I</td><td>8,091 m</td><td>ネパール</td><td></td></tr><tr><th scope=\"row\">11</th><td>Gasherbrum I</td><td>8,080 m</td><td>パキスタン・中国</td><td></td></tr><tr><th scope=\"row\">12</th><td>Broad Peak</td><td>8,051 m</td><td>パキスタン・中国</td><td></td></tr><tr><th scope=\"row\">13</th><td>Gasherbrum II</td><td>8,035 m</td><td>パキスタン・中国</td><td></td></tr><tr><th scope=\"row\">14</th><td colspan=\"2\" class=\"demo-merged-cell\"><strong>Shishapangma</strong> / 8,027 m</td><td>中国</td><td>横結合（山名＋標高）</td></tr><tr><th scope=\"row\">15</th><td>Gyachung Kang</td><td>7,952 m</td><td>ネパール・中国</td><td></td></tr><tr><th scope=\"row\">16</th><td>Annapurna II</td><td>7,937 m</td><td>ネパール</td><td></td></tr><tr><th scope=\"row\">17</th><td>Gasherbrum IV</td><td>7,932 m</td><td>パキスタン</td><td></td></tr><tr><th scope=\"row\">18</th><td>Himalchuli</td><td>7,893 m</td><td>ネパール</td><td></td></tr><tr><th scope=\"row\">19</th><td>Distaghil Sar</td><td>7,885 m</td><td>パキスタン</td><td></td></tr><tr><th scope=\"row\">20</th><td>Ngadi Chuli</td><td>7,871 m</td><td>ネパール</td><td></td></tr><tr><th scope=\"row\">21</th><td>Nuptse</td><td>7,861 m</td><td>ネパール</td><td></td></tr><tr><th scope=\"row\">22</th><td>Khunyang Chhish</td><td>7,852 m</td><td>パキスタン</td><td></td></tr><tr><th scope=\"row\">23</th><td>Masherbrum</td><td>7,821 m</td><td>パキスタン</td><td></td></tr><tr><th scope=\"row\">24</th><td>Nanda Devi</td><td>7,816 m</td><td>インド</td><td></td></tr><tr><th scope=\"row\">25</th><td>Chomo Lonzo</td><td>7,804 m</td><td>中国</td><td></td></tr><tr><th scope=\"row\">26</th><td>Batura Sar</td><td>7,795 m</td><td>パキスタン</td><td></td></tr><tr><th scope=\"row\">27</th><td>Rakaposhi</td><td>7,788 m</td><td>パキスタン</td><td></td></tr><tr><th scope=\"row\">28</th><td>Namcha Barwa</td><td>7,782 m</td><td>中国</td><td></td></tr><tr><th scope=\"row\">29</th><td>Kanjut Sar</td><td>7,760 m</td><td>パキスタン</td><td></td></tr><tr><th scope=\"row\">30</th><td>Kamet</td><td>7,756 m</td><td>インド</td><td></td></tr></tbody></table><figcaption>世界の山 30座 / Flexible Table Block デモ</figcaption></figure><!-- /wp:flexible-table-block/table -->\nHTML;\n\n$edit_url = '/wp-admin/post.php?post=' . $page_id . '&action=edit';\n\n$content =\n\t'<!-- wp:paragraph -->' .\n\t'<p>マウス・タッチ・キーボードで、WordPress Core Table と Flexible Table Block の行を並べ替えられます。</p>' .\n\t'<!-- /wp:paragraph -->' .\n\t'<!-- wp:paragraph -->' .\n\t'<p>下のボタンから編集画面を開いて、2種類のテーブルで Table Reorder を試してみてください。どちらも縦結合・横結合を含みます。</p>' .\n\t'<!-- /wp:paragraph -->' .\n\t'<!-- wp:buttons -->' .\n\t'<div class=\"wp-block-buttons\">' .\n\t'<!-- wp:button -->' .\n\t'<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"' . esc_url( $edit_url ) . '\">行の並べ替えを試す</a></div>' .\n\t'<!-- /wp:button -->' .\n\t'</div>' .\n\t'<!-- /wp:buttons -->' .\n\t'<!-- wp:separator -->' .\n\t'<hr class=\"wp-block-separator has-alpha-channel-opacity\"/>' .\n\t'<!-- /wp:separator -->' .\n\t'<!-- wp:heading -->' .\n\t'<h2 class=\"wp-block-heading\">WordPress Core Table：日本の山30座</h2>' .\n\t'<!-- /wp:heading -->' .\n\t'<!-- wp:paragraph -->' .\n\t'<p>7〜8行目の所在地は縦結合、14行目の山名＋標高は横結合です。</p>' .\n\t'<!-- /wp:paragraph -->' .\n\t$core_table .\n\t'<!-- wp:separator -->' .\n\t'<hr class=\"wp-block-separator has-alpha-channel-opacity\"/>' .\n\t'<!-- /wp:separator -->' .\n\t'<!-- wp:heading -->' .\n\t'<h2 class=\"wp-block-heading\">Flexible Table Block：世界の山30座</h2>' .\n\t'<!-- /wp:heading -->' .\n\t'<!-- wp:paragraph -->' .\n\t'<p>標高順の30座です。7〜8行目の所在地は縦結合、14行目の山名＋標高は横結合です。RichText、リンク、インラインコード、改行、scope、class、セルスタイルも含めています。</p>' .\n\t'<!-- /wp:paragraph -->' .\n\t$flexible_table .\n\t'<!-- wp:paragraph -->' .\n\t'<p>不具合や気づいた点があれば、<a href=\"https://github.com/YamabikoLab/yamabiko-editor-tools/issues\">GitHub Issues</a> からお知らせください。</p>' .\n\t'<!-- /wp:paragraph -->';\n\n$result = wp_insert_post(\n\t[\n\t\t'import_id'    => $page_id,\n\t\t'post_type'    => 'page',\n\t\t'post_status'  => 'publish',\n\t\t'post_title'   => '行の並べ替えデモ：日本と世界の山',\n\t\t'post_name'    => 'table-reorder-demo',\n\t\t'post_content' => $content,\n\t\t'post_author'  => 1,\n\t],\n\ttrue\n);\n\nif ( is_wp_error( $result ) ) {\n\tthrow new RuntimeException( $result->get_error_message() );\n}\n\nupdate_option( 'show_on_front', 'page' );\nupdate_option( 'page_on_front', $page_id );\n",
