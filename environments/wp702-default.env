ENVIRONMENT_NAME=wp702-default
COMPOSE_PROJECT_NAME=yamabiko-blocks-wp702-default
WORDPRESS_IMAGE_TAG=7.0.2-php8.3-apache
WORDPRESS_PORT=8080
WORDPRESS_SITE_URL=http://127.0.0.1:8080
EDITOR_MODE=default
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
WORDPRESS_DB_ROOT_PASSWORD=wordpress-root
WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=admin
WORDPRESS_ADMIN_EMAIL=admin@example.test
LOCAL_UID=1000
LOCAL_GID=1000

TZ=Asia/Tokyo
LOCALE=ja_JP.UTF-8

# WordPress開発コンテナ内のAIツール設定データ保存先です。
# 標準値はCodex互換です。Claude Code向けには /var/www/.claude などに変更できますが、
# ツール側にも同じ保存先を使う設定が別途必要です。
AI_TOOL_DATA_DIR=/var/www/.codex