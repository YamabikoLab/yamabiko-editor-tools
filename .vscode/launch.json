{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "chrome",
			"request": "launch",
			"name": "chrome",
			"url": "${env:WORDPRESS_SITE_URL}/wp-login.php",
			"webRoot": "${workspaceFolder}",
			"sourceMaps": true
		},
		{
			"type": "php",
			"request": "launch",
			"name": "Listen for Xdebug",
			"port": 9003,
			"pathMappings": {
				"/var/www/html/wp-content/plugins/yamabiko-editor-tools": "${workspaceFolder}"
			}
		}
	]
}
